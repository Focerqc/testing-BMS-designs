(version 1)
# Generated by _tools/kicad_sch/make_rules.py from the nets on the board.
# Don't edit by hand: change the script and run it again.
# Sources: docs/slave-18s-design-basis.md, 'Net classes and clearance rules'.
#
# 1. Stack clearance, IPC-2221B Table 6-1, column B2 (external, uncoated, up to 3050 m):
#    0-30 V needs 0.1 mm (the 0.2 mm net-class clearance covers it), 31-150 V needs 0.6 mm.
#    Each net's level is its tap number (V- = 0 ... top of stack = 18; VREG, VREF, GPIO
#    and the isoSPI chip side are level 0). bank = level // 3. Two nets in the same or
#    neighbouring banks are at most 6 levels apart (an S pin sits up to one level below
#    its tap while balancing): 6 x 4.2 V = 25.2 V < 30 V. Two or more banks apart they
#    can differ by 31-75.6 V, so they get 0.6 mm. Items with no net count as bank 0.

(rule "Stack: bank 0 (levels 0-2) vs banks 2-6, B2 31-150 V"
  (constraint clearance (min 0.6mm))
  (condition "!(A.NetName == '/C10_F' || A.NetName == '/C11_F' || A.NetName == '/C12_F' || A.NetName == '/C13_F' || A.NetName == '/C14_F' || A.NetName == '/C15_F' || A.NetName == '/C16_F' || A.NetName == '/C17_F' || A.NetName == '/C18_F' || A.NetName == '/C3_F' || A.NetName == '/C4_F' || A.NetName == '/C5_F' || A.NetName == '/C6_F' || A.NetName == '/C7_F' || A.NetName == '/C8_F' || A.NetName == '/C9_F' || A.NetName == '/CELL10' || A.NetName == '/CELL11' || A.NetName == '/CELL12' || A.NetName == '/CELL13' || A.NetName == '/CELL14' || A.NetName == '/CELL15' || A.NetName == '/CELL16' || A.NetName == '/CELL17' || A.NetName == '/CELL18' || A.NetName == '/CELL3' || A.NetName == '/CELL4' || A.NetName == '/CELL5' || A.NetName == '/CELL6' || A.NetName == '/CELL7' || A.NetName == '/CELL8' || A.NetName == '/CELL9' || A.NetName == '/ISOA_LN' || A.NetName == '/ISOA_LP' || A.NetName == '/ISOB_LN' || A.NetName == '/ISOB_LP' || A.NetName == '/S10' || A.NetName == '/S11' || A.NetName == '/S12' || A.NetName == '/S13' || A.NetName == '/S14' || A.NetName == '/S15' || A.NetName == '/S16' || A.NetName == '/S17' || A.NetName == '/S18' || A.NetName == '/S3' || A.NetName == '/S4' || A.NetName == '/S5' || A.NetName == '/S6' || A.NetName == '/S7' || A.NetName == '/S8' || A.NetName == '/S9' || A.NetName == '/VCOLL' || A.NetName == '/VP_F' || A.NetName == 'unconnected-(J3-MountPin-PadMP)' || A.NetName == 'unconnected-(J3-MountPin-PadMP)_1' || A.NetName == 'unconnected-(J4-MountPin-PadMP)' || A.NetName == 'unconnected-(J4-MountPin-PadMP)_1' || A.NetName == 'unconnected-(T501-LINE_CT-Pad5)' || A.NetName == 'unconnected-(T601-LINE_CT-Pad5)') && (B.NetName == '/C10_F' || B.NetName == '/C11_F' || B.NetName == '/C12_F' || B.NetName == '/C13_F' || B.NetName == '/C14_F' || B.NetName == '/C15_F' || B.NetName == '/C16_F' || B.NetName == '/C17_F' || B.NetName == '/C18_F' || B.NetName == '/C6_F' || B.NetName == '/C7_F' || B.NetName == '/C8_F' || B.NetName == '/C9_F' || B.NetName == '/CELL10' || B.NetName == '/CELL11' || B.NetName == '/CELL12' || B.NetName == '/CELL13' || B.NetName == '/CELL14' || B.NetName == '/CELL15' || B.NetName == '/CELL16' || B.NetName == '/CELL17' || B.NetName == '/CELL18' || B.NetName == '/CELL6' || B.NetName == '/CELL7' || B.NetName == '/CELL8' || B.NetName == '/CELL9' || B.NetName == '/S10' || B.NetName == '/S11' || B.NetName == '/S12' || B.NetName == '/S13' || B.NetName == '/S14' || B.NetName == '/S15' || B.NetName == '/S16' || B.NetName == '/S17' || B.NetName == '/S18' || B.NetName == '/S6' || B.NetName == '/S7' || B.NetName == '/S8' || B.NetName == '/S9' || B.NetName == '/VCOLL' || B.NetName == '/VP_F')"))

(rule "Stack: bank 1 (levels 3-5) vs banks 3-6, B2 31-150 V"
  (constraint clearance (min 0.6mm))
  (condition "(A.NetName == '/C3_F' || A.NetName == '/C4_F' || A.NetName == '/C5_F' || A.NetName == '/CELL3' || A.NetName == '/CELL4' || A.NetName == '/CELL5' || A.NetName == '/S3' || A.NetName == '/S4' || A.NetName == '/S5') && (B.NetName == '/C10_F' || B.NetName == '/C11_F' || B.NetName == '/C12_F' || B.NetName == '/C13_F' || B.NetName == '/C14_F' || B.NetName == '/C15_F' || B.NetName == '/C16_F' || B.NetName == '/C17_F' || B.NetName == '/C18_F' || B.NetName == '/C9_F' || B.NetName == '/CELL10' || B.NetName == '/CELL11' || B.NetName == '/CELL12' || B.NetName == '/CELL13' || B.NetName == '/CELL14' || B.NetName == '/CELL15' || B.NetName == '/CELL16' || B.NetName == '/CELL17' || B.NetName == '/CELL18' || B.NetName == '/CELL9' || B.NetName == '/S10' || B.NetName == '/S11' || B.NetName == '/S12' || B.NetName == '/S13' || B.NetName == '/S14' || B.NetName == '/S15' || B.NetName == '/S16' || B.NetName == '/S17' || B.NetName == '/S18' || B.NetName == '/S9' || B.NetName == '/VCOLL' || B.NetName == '/VP_F')"))

(rule "Stack: bank 2 (levels 6-8) vs banks 4-6, B2 31-150 V"
  (constraint clearance (min 0.6mm))
  (condition "(A.NetName == '/C6_F' || A.NetName == '/C7_F' || A.NetName == '/C8_F' || A.NetName == '/CELL6' || A.NetName == '/CELL7' || A.NetName == '/CELL8' || A.NetName == '/S6' || A.NetName == '/S7' || A.NetName == '/S8') && (B.NetName == '/C12_F' || B.NetName == '/C13_F' || B.NetName == '/C14_F' || B.NetName == '/C15_F' || B.NetName == '/C16_F' || B.NetName == '/C17_F' || B.NetName == '/C18_F' || B.NetName == '/CELL12' || B.NetName == '/CELL13' || B.NetName == '/CELL14' || B.NetName == '/CELL15' || B.NetName == '/CELL16' || B.NetName == '/CELL17' || B.NetName == '/CELL18' || B.NetName == '/S12' || B.NetName == '/S13' || B.NetName == '/S14' || B.NetName == '/S15' || B.NetName == '/S16' || B.NetName == '/S17' || B.NetName == '/S18' || B.NetName == '/VCOLL' || B.NetName == '/VP_F')"))

(rule "Stack: bank 3 (levels 9-11) vs banks 5-6, B2 31-150 V"
  (constraint clearance (min 0.6mm))
  (condition "(A.NetName == '/C10_F' || A.NetName == '/C11_F' || A.NetName == '/C9_F' || A.NetName == '/CELL10' || A.NetName == '/CELL11' || A.NetName == '/CELL9' || A.NetName == '/S10' || A.NetName == '/S11' || A.NetName == '/S9') && (B.NetName == '/C15_F' || B.NetName == '/C16_F' || B.NetName == '/C17_F' || B.NetName == '/C18_F' || B.NetName == '/CELL15' || B.NetName == '/CELL16' || B.NetName == '/CELL17' || B.NetName == '/CELL18' || B.NetName == '/S15' || B.NetName == '/S16' || B.NetName == '/S17' || B.NetName == '/S18' || B.NetName == '/VCOLL' || B.NetName == '/VP_F')"))

(rule "Stack: bank 4 (levels 12-14) vs bank 6, B2 31-150 V"
  (constraint clearance (min 0.6mm))
  (condition "(A.NetName == '/C12_F' || A.NetName == '/C13_F' || A.NetName == '/C14_F' || A.NetName == '/CELL12' || A.NetName == '/CELL13' || A.NetName == '/CELL14' || A.NetName == '/S12' || A.NetName == '/S13' || A.NetName == '/S14') && (B.NetName == '/C18_F' || B.NetName == '/CELL18' || B.NetName == '/S18' || B.NetName == '/VCOLL' || B.NetName == '/VP_F')"))

# 2. isoSPI barrier. Each line side (connector to transformer pins 4-6) floats between
#    this module and its neighbour: up to 2 x 75.6 V = 151.2 V. IPC-2221B B2 151-300 V
#    needs 1.25 mm; 2.0 mm leaves margin for motor common-mode transients and ESD
#    on the connector. On a flat board without slots creepage equals the clearance.
#    Listed after the stack rules so it wins where both match.

(rule "isoSPI A line side vs everything else"
  (constraint clearance (min 2.0mm))
  (constraint creepage (min 2.0mm))
  (condition "(A.NetName == '/ISOA_LN' || A.NetName == '/ISOA_LP' || A.NetName == 'unconnected-(J3-MountPin-PadMP)' || A.NetName == 'unconnected-(J3-MountPin-PadMP)_1' || A.NetName == 'unconnected-(T501-LINE_CT-Pad5)') && !(B.NetName == '/ISOA_LN' || B.NetName == '/ISOA_LP' || B.NetName == 'unconnected-(J3-MountPin-PadMP)' || B.NetName == 'unconnected-(J3-MountPin-PadMP)_1' || B.NetName == 'unconnected-(T501-LINE_CT-Pad5)')"))

(rule "isoSPI B line side vs everything else"
  (constraint clearance (min 2.0mm))
  (constraint creepage (min 2.0mm))
  (condition "(A.NetName == '/ISOB_LN' || A.NetName == '/ISOB_LP' || A.NetName == 'unconnected-(J4-MountPin-PadMP)' || A.NetName == 'unconnected-(J4-MountPin-PadMP)_1' || A.NetName == 'unconnected-(T601-LINE_CT-Pad5)') && !(B.NetName == '/ISOB_LN' || B.NetName == '/ISOB_LP' || B.NetName == 'unconnected-(J4-MountPin-PadMP)' || B.NetName == 'unconnected-(J4-MountPin-PadMP)_1' || B.NetName == 'unconnected-(T601-LINE_CT-Pad5)')"))

# 3. ADBMS1818 datasheet Rev. B p. 86, isoSPI layout guidelines: no V- plane under the
#    transformer or the connector (item 2), no foreign traces across the isoSPI lines
#    (item 3). Courtyards stand in for 'under'; the gap between transformer and
#    connector is on the placement checklist.

(rule "No copper pour under T501 or J3"
  (constraint disallow zone)
  (condition "A.intersectsCourtyard('T501') || A.intersectsCourtyard('J3')"))

(rule "Only isoSPI A tracks and vias inside T501 and J3"
  (constraint disallow track via)
  (condition "(A.intersectsCourtyard('T501') || A.intersectsCourtyard('J3')) && !(A.NetName == '/IMA' || A.NetName == '/IPA' || A.NetName == '/ISOA_CM' || A.NetName == '/ISOA_CT' || A.NetName == '/ISOA_LN' || A.NetName == '/ISOA_LP' || A.NetName == 'unconnected-(J3-MountPin-PadMP)' || A.NetName == 'unconnected-(J3-MountPin-PadMP)_1' || A.NetName == 'unconnected-(T501-LINE_CT-Pad5)')"))

(rule "No copper pour under T601 or J4"
  (constraint disallow zone)
  (condition "A.intersectsCourtyard('T601') || A.intersectsCourtyard('J4')"))

(rule "Only isoSPI B tracks and vias inside T601 and J4"
  (constraint disallow track via)
  (condition "(A.intersectsCourtyard('T601') || A.intersectsCourtyard('J4')) && !(A.NetName == '/IMB' || A.NetName == '/IPB' || A.NetName == '/ISOB_CM' || A.NetName == '/ISOB_CT' || A.NetName == '/ISOB_LN' || A.NetName == '/ISOB_LP' || A.NetName == 'unconnected-(J4-MountPin-PadMP)' || A.NetName == 'unconnected-(J4-MountPin-PadMP)_1' || A.NetName == 'unconnected-(T601-LINE_CT-Pad5)')"))

# 4. Mounting holes H1-H4 (M2, NPTH, 2.2 mm): keep copper 2.75 mm from the hole centre so
#    an M2 screw head or nylon washer (about 5 mm across) never touches copper. 1.65 mm
#    from the hole edge = 2.75 mm - 1.1 mm hole radius.

(rule "Mounting hole copper keep-out"
  (constraint hole_clearance (min 1.65mm))
  (condition "A.memberOfFootprint('H*')"))
